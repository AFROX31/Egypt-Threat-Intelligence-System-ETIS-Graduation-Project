# ETIS backend settings. Copy this file to the PROJECT ROOT as .env
# (Windows: copy backend\.env.example .env) and fill in your own values.
# Every setting is read by backend/app/core/config.py. A variable set in the
# terminal window wins over the same line in .env. Never commit .env.

# PostgreSQL connection. Replace YOUR_PASSWORD_HERE with your postgres password
# (no brackets or quotes). Use the etis_eval database only for evaluations.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/etis

# --- Authentication -----------------------------------------------------------
# false = every request is let through (local development). Set true on any
# hosted deployment. The dashboard then gets a short-lived HttpOnly session
# cookie (after the Turnstile bot check), and programs such as the Gmail
# extension use their own API key from:  py -3.13 manage_api_keys.py create <name>
ETIS_AUTH_REQUIRED=false

# Signs the session cookies. Required when ETIS_AUTH_REQUIRED=true, 32+ characters.
# Generate one with:  py -3.13 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs every dashboard user out (they get a new session automatically).
ETIS_SESSION_SECRET=

# How long a dashboard session lasts, in seconds.
ETIS_SESSION_TTL_SECONDS=3600

# Cookie flags. Keep Secure=true (browsers accept it on http://localhost too).
# SameSite=lax works when the dashboard and API share a site (same origin via
# ETIS_FRONTEND_DIST, or subdomains of one domain you own).
ETIS_COOKIE_SECURE=true
ETIS_COOKIE_SAMESITE=lax

# Cloudflare Turnstile bot check before a session is issued. Set both or neither.
# Real keys: Cloudflare dashboard -> Turnstile -> Add widget (free).
# Test keys that always pass (local testing, no account needed):
#   ETIS_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   ETIS_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ETIS_TURNSTILE_SITE_KEY=
ETIS_TURNSTILE_SECRET_KEY=

# Browser origins allowed to call the API, comma-separated, no trailing slash.
# Add the hosted dashboard's address here when you deploy it.
ETIS_CORS_ORIGINS=http://localhost:5173

# Must stay true: the dashboard's session cookie needs it.
ETIS_CORS_ALLOW_CREDENTIALS=true

# Rate limits (slowapi format). /analyze: per caller (one dashboard session or
# one API client) and per IP. /session: per IP.
ETIS_ANALYZE_RATE_LIMIT=20/minute
ETIS_ANALYZE_IP_RATE_LIMIT=60/minute
ETIS_SESSION_RATE_LIMIT=10/minute

# Input limits. Longer input is refused with HTTP 400 (413 for the whole body).
ETIS_MAX_TEXT_CHARS=20000
ETIS_MAX_URL_CHARS=4096
ETIS_MAX_REQUEST_BYTES=256000

# How many links found inside a message text are scanned (the rest are counted only).
ETIS_MAX_EMBEDDED_LINKS=5

# Set to 1 to skip loading the models at startup (faster restarts while
# developing). Leave it unset for the demo, so the first scan is fast.
# ETIS_SKIP_WARMUP=1

# Hosted deployment: serve the built dashboard (npm run build) from the API's
# own origin, so the session cookie is first-party. Leave unset for local dev.
# ETIS_FRONTEND_DIST=../etis-frontend/dist
