# Where the ETIS backend is. Local development: the uvicorn server from SETUP.md step 6.
# For a hosted build served by the backend itself (ETIS_FRONTEND_DIST), set it empty:
#   VITE_API_BASE_URL=
# Nothing secret belongs in this file: every VITE_ value is copied into the
# public JavaScript. The dashboard authenticates with a session cookie instead.
VITE_API_BASE_URL=http://localhost:8000
